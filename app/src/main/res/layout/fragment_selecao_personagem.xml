<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragment.SelecaoPersonagemFragment">

    <TextView
        android:id="@+id/txtTituloSelecaoPersonagem"
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/stringSelecionarPersonagem"
        app:layout_constraintEnd_toStartOf="@id/btnFecharSelecaoPersonagem"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnFecharSelecaoPersonagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/stringFecharModal"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/txtTituloSelecaoPersonagem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtTituloSelecaoPersonagem"
        app:layout_constraintTop_toTopOf="@+id/txtTituloSelecaoPersonagem" />

    <RadioGroup
        android:id="@+id/radioGroupSelecaoPersonagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="start"
        app:layout_constraintStart_toStartOf="@+id/txtTituloSelecaoPersonagem"
        app:layout_constraintEnd_toEndOf="@id/btnFecharSelecaoPersonagem"
        app:layout_constraintTop_toBottomOf="@id/txtTituloSelecaoPersonagem"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmarSelecaoPersonagem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stringConfirmar"
        app:layout_constraintEnd_toEndOf="@+id/radioGroupSelecaoPersonagem"
        app:layout_constraintTop_toBottomOf="@+id/radioGroupSelecaoPersonagem" />
</androidx.constraintlayout.widget.ConstraintLayout>