<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/card"
    android:id="@+id/itemCardTrabalhoEstoque">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/itemNomeTrabalhoEstoque"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/itemQuantidadeContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Trabalho Muito Grande Aqui" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemQuantidadeContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemNomeTrabalhoEstoque"
            app:layout_constraintEnd_toStartOf="@id/itemNivelContainer"
            app:layout_constraintTop_toTopOf="@+id/itemNomeTrabalhoEstoque"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/itemQuantidadeTrabalhoEstoque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="120 und" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/itemNivelContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/cor_primaria_transparente"
            app:cardCornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/itemQuantidadeContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/itemQuantidadeContainer"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/itemNivelTrabalhoEstoque"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Nv. 10" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>