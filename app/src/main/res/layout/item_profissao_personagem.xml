<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android="http://schemas.android.com/apk/res/android"
    style="@style/card"
    android:id="@+id/cardViewProfissaoPersonagem">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/itemNivelProfissaoPersonagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:layout_margin="16dp"
            android:padding="8dp"
            android:textStyle="bold"
            style="@style/TextAppearance.Texto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="26"
        />

        <TextView
            android:id="@+id/itemNomeProfissaoPersonagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:textSize="22sp"
            android:textStyle="bold"
            style="@style/TextAppearance.Texto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/itemNivelProfissaoPersonagem"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Profissao"
            />

        <TextView
            android:id="@+id/itemExperienciaProfissaoPersonagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:padding="8dp"
            android:layout_marginBottom="16dp"
            style="@style/TextAppearance.Texto"
            app:layout_constraintStart_toStartOf="@+id/itemNomeProfissaoPersonagem"
            app:layout_constraintEnd_toEndOf="@id/itemNomeProfissaoPersonagem"
            app:layout_constraintTop_toBottomOf="@id/itemNomeProfissaoPersonagem"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Experiência"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>